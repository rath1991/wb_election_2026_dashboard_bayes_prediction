# Copy this to .env and fill in your keys
# Never commit .env to git

# Anthropic (Claude API) — required for noise filtering + signal extraction
ANTHROPIC_KEY=your-anthropic-key-here

# NewsAPI.ai — get free key at newsapi.ai
NEWS_API_KEY=your-newsapi-ai-uuid-key-here

# YouTube Data API — optional (console.cloud.google.com)
YOUTUBE_API_KEY=your-youtube-api-key-here

# DuckDB path — override on Render to use persistent disk
# DB_PATH=/data/wb_elections.duckdb

# Admin credentials for pipeline trigger (set these in Render env vars)
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=your-strong-password
